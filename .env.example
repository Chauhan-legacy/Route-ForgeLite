# RouteForge Environment Configuration
# Note: RouteForge is built 100% on free-tier and open-source services.
# Absolutely NO paid API keys, billing accounts, or credit cards are needed.

# Host and Port Configuration for Local Server
HOST=0.0.0.0
PORT=8000

# SQLite Database File Path
DATABASE_PATH=database/routeforge.db

# Frontend API URL
# Leave empty for relative path /api when running locally or proxied
# When deploying frontend to Vercel with a remote backend, specify the backend URL (e.g., https://your-backend.railway.app)
# If left empty on Vercel, RouteForge runs autonomously in client-side fallback mode with direct OSRM and local storage!
VITE_API_URL=

