    "server": "npm --prefix local run server",
    "client": "npm --prefix local run client",
    "build": "npm --prefix local run build",
    "start": "npm --prefix local run start"
  },
  "keywords": [
    "route-planner",
    "apps-script",
    "leaflet",
    "osrm",
    "2-opt",
    "nearest-neighbor",
    "collaborative"
