{
  "name": "routeforge",
  "version": "1.0.0",
  "description": "RouteForge: Dual-Target Collaborative Multi-Stop Route Planner",
  "private": true,
  "scripts": {
    "test": "node tests/shared.test.js && node tests/server.test.js && node tests/e2e.test.js",
    "test:shared": "node tests/shared.test.js",
