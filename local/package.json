{
  "name": "routeforge-local",
  "version": "1.0.0",
  "description": "RouteForge Local Self-Hosted Stack (Express + React)",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:client",
    "start": "NODE_ENV=production node server/index.js",
    "dev": "concurrently -k -n \"server,client\" -c \"blue,green\" \"node server/index.js\" \"npm --prefix client run dev\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "sql.js": "^1.15.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
