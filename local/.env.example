# RouteForge Local Environment Configuration

PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=*

# Storage Adapter: 'memory' or 'sqlite'
STORAGE=memory

# Path to SQLite database file (when STORAGE=sqlite)
SQLITE_PATH=./routeforge.sqlite

# Security & Authentication: 'none' or 'shared-secret'
AUTH_MODE=none
SHARED_SECRET=your-secure-secret-token-here

